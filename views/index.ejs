<section class="hero">
  <div class="hero__scrim"></div>

  <div class="hero__content">

    <article class="card concept fade-up">
      <h1 class="concept__title">Success isn't built on burnout.</h1>
      <p>📵 In a world where we are constantly "online" we need better ways to recover from technology.</p>
      <p>🌿 I am creating exclusive retreat experiences focused on <em>digital wellbeing</em>, <em>uninterrupted social connection</em> and <em>outdoor activities</em>.</p>
      <p>🤝 No quiet isolation — just nature, genuine human interaction, active adventure and real life as it was meant to be.</p>
    </article>

    <article class="card cta fade-up fade-up--delay">
      <% if (typeof signupSuccess !== 'undefined' && signupSuccess) { %>
        <p class="cta__success">You're on the list. I'll be in touch soon. 🎉</p>
      <% } else if (typeof signupExists !== 'undefined' && signupExists) { %>
        <p class="cta__success">You're already on the list. 🙏 I'll be in touch soon. 🌿</p>
      <% } else { %>
        <h2 class="cta__heading">Join the waitlist for my first retreat</h2>
        <% if (typeof signupError !== 'undefined' && signupError) { %>
          <p class="cta__error"><%= signupErrorMessage %></p>
        <% } %>
        <form class="cta__form" action="/waitlist" method="POST">
          <input
            type="email"
            name="email"
            class="cta__input"
            placeholder="Enter your email address"
            required
          />
          <button type="submit" class="cta__button">Sign Up &rarr;</button>
        </form>
        <p class="cta__microcopy">
          No spam, just updates.
        </p>
      <% } %>
    </article>
  </div>
</section>
